# Cluster environment for launchers/submit.sh and every launcher in this folder.
# Copy to launchers/env.sh (gitignored) and edit the values. Sourced with `set -a`, so plain assignments are exported.

PROJECT=/path/to/gliner2-kvkk-tr              # this repository on the cluster (code; datasets/ models/ results/ may be symlinks to scratch)
SIF=/path/to/sif_files/gliner2_h100.sif       # container built from launchers/gliner2_h100.def
SLURM_ACCOUNT=your_account
SLURM_QOS=your_gpu_qos                        # the production GPU queue; SLURM_QOS_DEBUG for smoke tests
SLURM_QOS_DEBUG=your_debug_qos
LOGDIR=$PROJECT/launchers/logs
CONTAINER_MODULE=singularity                  # `module load $CONTAINER_MODULE`; empty if the container runtime needs no module

# how the recipes run python: inside the container, with the GPU
PY="singularity exec --nv $SIF python"
DEVICE=cuda
OFFLINE=1                                     # no internet on compute nodes: models are folders under $PROJECT/models
RESULTS=results
