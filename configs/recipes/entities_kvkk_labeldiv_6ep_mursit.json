{
  "_comment": "Same recipe with the Mursit-Base (Turkish ModernBERT) encoder + the gliner2.5 boundary head config (records/relations disabled, so this checkpoint has NO relation head and cannot be a relations base). Native tokenization + BOS + mean pooling. Lost the encoder bake-off to the mDeBERTa recipe (0.927 vs 0.933 training F1, -8.7 vs -0.9 on unseen label wordings); kept for the comparison.",
  "run_name": "entities_kvkk_labeldiv_6ep_mursit",
  "seed": 42,
  "model": {
    "model_name": "models/Mursit-Base",
    "boundary_head_from": "models/gliner2.5-multi-v1",
    "boundary_head_overrides": {
      "enable_records": false,
      "enable_relations": false
    },
    "token_pooling": "mean",
    "tokenization": "native",
    "add_bos": true,
    "attn_implementation": "sdpa",
    "max_len": 1024
  },
  "training": {
    "max_steps": 9378,
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "eval_batch_size": 32,
    "encoder_lr": 2e-05,
    "task_lr": 0.0005,
    "warmup_ratio": 0.1,
    "scheduler_type": "linear",
    "fp16": false,
    "bf16": true,
    "eval_strategy": "steps",
    "eval_steps": 1000,
    "save_total_limit": 2,
    "save_best": true,
    "metric_for_best": "exact_f1_micro",
    "greater_is_better": true,
    "logging_steps": 50,
    "max_len": 1024,
    "on_capacity_exceeded": "skip_sample",
    "num_workers": 4,
    "pin_memory": true,
    "validate_data": true,
    "report_to_wandb": false,
    "allow_invalid_samples": true
  },
  "eval": {
    "batch_size": 32,
    "threshold": 0.5
  }
}
